# Copy to .env to override the defaults. Only CORRECTOR_* settings belong here.
# The Groq API key is NOT configured here: each user sends their own with every request.
# CORRECTOR_GROQ_BASE_URL=https://api.groq.com/openai/v1
# CORRECTOR_MODEL=openai/gpt-oss-120b
# CORRECTOR_TIMEOUT_S=30
# CORRECTOR_MAX_INPUT_CHARS=5000
# low, medium or high; `none` omits it (needed for models without reasoning support)
# CORRECTOR_REASONING_EFFORT=low
